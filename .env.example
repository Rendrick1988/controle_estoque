# Copie para `.env` na raiz do repositório (mesmo nível que compose.yaml).
# Este modelo não contém credenciais. Copie para .env, que continua ignorado pelo Git,
# e preencha os valores locais antes de iniciar o Docker Compose. A DATABASE_URL
# abaixo é para executar Python diretamente na máquina; o Compose monta a URL do container.

DATABASE_URL=""
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=controle_estoque
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
APP_BASE_URL=http://localhost:8000
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_API_BASE_URL=https://api.mercadopago.com
MERCADO_PAGO_NOTIFICATION_URL=

# Recuperação de senha (JWT no fluxo atual). PASSWORD_RESET_TOKEN_IN_RESPONSE=false em produção pública recomendável (combinar HTTPS + e-mail SMTP no futuro).
PASSWORD_RESET_EXPIRE_MINUTES=60
PASSWORD_RESET_TOKEN_IN_RESPONSE=true

# Opcional no Docker: 0 = não rodar alembic ao iniciar o container (só produção customizada)
# RUN_MIGRATIONS=1
